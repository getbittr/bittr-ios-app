<?xml version="1.0" encoding="utf-8"?>
<!--
  Copy source: shared/strings/en.json. Do not reword here.

  These three strings are permanently on the user's screen while the wallet is
  running, which makes them shipped copy, so they are authored once in
  shared/strings/en.json and reach both apps from there (shared/strings/README.md).
  The generator that would make this file a build artefact does not exist yet, so
  until it does the two are kept identical by hand — the same arrangement the
  README describes for every other key that has already moved.

  They carry a review trail and three standing constraints, all recorded in
  shared/strings/README.md under "The wallet's foreground-service notification".
  The short version, because this is the file someone edits in a hurry:

  - No freshness claim. Not "syncing", not "up to date". ldk-node's intervals run
    on Rust threads Doze can freeze, and whether they are honoured is unmeasured
    until K8 (BIT-123).
  - No balance and no amount. The notification is VISIBILITY_SECRET so it does
    not render on the lock screen; that decision has to be reopened before
    anything financial goes in here.
  - Nothing that reads as custody or protection. bittr is non-custodial and
    cannot recover anything (bittr-regulatory-perimeter).
-->
<resources>

    <!-- The Settings → Notifications channel name, and the shade's group label. -->
    <string name="wallet_node_service_channel">Wallet running</string>

    <!--
      A statement about the app, not about the network. "Running" rather than
      "open" on purpose: on Android the wallet runs while the app is backgrounded,
      which is the whole reason the service exists, and iOS's "have the app open"
      means foregrounded.
    -->
    <string name="wallet_node_service_title">Your bittr wallet is running</string>

    <!--
      A necessary condition, never a sufficient one: it says instant payments need
      the app, not that they will work because it is there. "Instant payments" is
      the app's own word for lightning (questionvc7, limitlightning); "node" and
      "connection" are not available here — the app has never shown the user the
      word node, and "connection" already means their channel.
    -->
    <string name="wallet_node_service_text">Instant payments need the app running.</string>

</resources>
