<?xml version="1.0" encoding="utf-8"?>
<!-- The same adaptive icon as ic_launcher, for launchers that ask for android:roundIcon.
     Adaptive icons are masked by the launcher anyway, so there is nothing to round here;
     this exists so a launcher that resolves roundIcon first still gets the adaptive one
     rather than falling back to the raster in mipmap-*dpi. -->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@drawable/ic_launcher_background" />
    <foreground android:drawable="@drawable/ic_launcher_foreground" />
    <monochrome android:drawable="@drawable/ic_launcher_monochrome" />
</adaptive-icon>
