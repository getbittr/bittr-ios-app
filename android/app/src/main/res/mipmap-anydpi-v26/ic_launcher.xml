<?xml version="1.0" encoding="utf-8"?>
<!-- The iOS app icon, split into layers by android/scripts/render-launcher-icon.swift: the mark
     from ios/bittr/Assets.xcassets/AppIcon.appiconset over the same yellow, sized so the iOS square
     fills the 72 dp a launcher shows. `monochrome` is what Android 13+ tints for a themed icon;
     without it the launcher falls back to the full-colour one, which is not wrong but is not the
     user's theme either. -->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@drawable/ic_launcher_background" />
    <foreground android:drawable="@mipmap/ic_launcher_foreground" />
    <monochrome android:drawable="@mipmap/ic_launcher_monochrome" />
</adaptive-icon>
