# bittr's MAINNET node configuration — the six BITTR_LDK_* values a release build
# compiles into BuildConfig.
#
#   set -a; . android/production.env; set +a
#   ./gradlew :app:bundleRelease
#
# NOT SECRET, and committed on purpose. Every value here is already in the
# repository, in ios/bittr/Helpers/EnvironmentConfig.swift, which both platforms
# take as the source of truth. Keeping a second copy in someone's home directory
# only meant the CI workflow and the laptop could drift apart without either
# noticing.
#
# **Deliberately not loaded by .envrc.** The regtest environment is ambient
# because every debug build wants it; this one is opted into for a single command,
# so that no ordinary build can quietly point at mainnet. `:app:bundleRelease`
# refuses a bundle whose node configuration is not mainnet — see the check at the
# bottom of app/build.gradle.kts — but nothing stops a debug build from using
# whatever is in the shell, and a debug build on mainnet is a real wallet with
# BITTR_ENVIRONMENT=DEVELOPMENT behind it.
#
# All six are set, including the empty token: these are meant to override the
# regtest values already in the shell, and a variable this file omitted would keep
# its regtest value instead.
#
# If BITTR_LDK_LSPS2_TOKEN ever becomes a real token, it stops being publishable
# and this file has to lose it — a secret in CI, and ~/.bittr locally.

# EnvironmentConfig.esploraURL
BITTR_LDK_CHAIN_SOURCE_URL=https://esplora.getbittr.com/api

# EnvironmentConfig.electrumURL
BITTR_LDK_ELECTRUM_URL=ssl://esplora.getbittr.com:50002

# EnvironmentConfig.RGSServerURLs.bitcoin
BITTR_LDK_RAPID_GOSSIP_SYNC_URL=https://rapidsync.lightningdevkit.org/snapshot/v2

# EnvironmentConfig.lightningNodeId
BITTR_LDK_LIGHTNING_NODE_ID=03e8d988a67ee7de983cd39d9d3d4d19771019305da4d2332be76c8b9fb1687776

# EnvironmentConfig.lightningNodeAddress
BITTR_LDK_LIGHTNING_NODE_ADDRESS=86.104.228.24:9735

# BitcoinManager.swift passes token: "" on both environments.
BITTR_LDK_LSPS2_TOKEN=
