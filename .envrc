# The environment this repo's builds expect, loaded by direnv on `cd`.
#
# NO SECRETS IN THIS FILE. It is committed, and it is executed by every person
# who allows it. Everything it loads lives in ~/.bittr/, outside the repository,
# at mode 600 — see android/docs/play-release.md for the upload key and
# android/docs/local-setup-macos.md for the node configuration.
#
# `direnv allow` is needed once per checkout and again whenever this file
# changes. That is direnv refusing to run a file nobody has looked at, which is
# the reason to keep the file worth looking at.
#
# Both blocks below use `set -a` and `.` rather than direnv's `dotenv`, so the
# files are read with exactly the same shell semantics as
# `set -a; source ...; set +a` in the docs and in shared/flows/test_suite_android.sh.
# A password containing a `#` or a quote then behaves the same everywhere,
# instead of the same in three places and differently in the fourth.

# The Lightning node's deployment configuration: the four BITTR_LDK_* values
# app/build.gradle.kts compiles into BuildConfig. Absent is normal — a build
# without them is a build with no node endpoints, which is what CI produces and
# what LdkEnvironment reports at run time.
if [ -f "$HOME/.bittr/android-regtest.env" ]; then
  watch_file "$HOME/.bittr/android-regtest.env"
  set -a
  . "$HOME/.bittr/android-regtest.env"
  set +a
fi

# The Play upload key: the four BITTR_UPLOAD_* values that let
# `:app:bundleRelease` produce something Play will accept. Absent is normal too
# — only a release bundle needs them, and the build names the missing ones.
if [ -f "$HOME/.bittr/upload-key.env" ]; then
  watch_file "$HOME/.bittr/upload-key.env"
  set -a
  . "$HOME/.bittr/upload-key.env"
  set +a
fi

# Anything machine-specific, untracked by design: .envrc.local is in .gitignore.
if [ -f .envrc.local ]; then
  watch_file .envrc.local
  set -a
  . ./.envrc.local
  set +a
fi
